PORT=5000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=info

# Storage mode:
#   local  – filesystem (no credentials needed, good for local dev)
#   s3     – AWS S3 / Cloudflare R2 / MinIO
# If omitted: uses "s3" when STORAGE_BUCKET + keys are set, otherwise "local"
STORAGE_MODE=local

# --- Required only when STORAGE_MODE=s3 ---
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Set to true for MinIO / path-style endpoints
STORAGE_FORCE_PATH_STYLE=false

# Optional: public base URL for local files (defaults to http://localhost:PORT/local-files)
# LOCAL_STORAGE_PUBLIC_URL=http://localhost:5000/local-files

MAX_FILE_SIZE_MB=500
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=20

# Optional overrides if binaries are not in PATH
# YTDLP_PATH=/usr/local/bin/yt-dlp
# FFMPEG_PATH=/usr/bin/ffmpeg
